# Environment — copy this file to .env and fill in your values.
# Never commit the real .env file.

# ── Backend ──────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./satyalens.db

# Upload storage directory (relative to backend/)
UPLOAD_DIR=uploads

# Person 1 analysis package (satyalens_analysis). Disabled by default.
# To enable for testing: pip install -e "<repo root>[ml]" into the backend
# venv, set this to true, and restart the backend (adapter loads at startup).
ANALYSIS_MODULE_ENABLED=false

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
